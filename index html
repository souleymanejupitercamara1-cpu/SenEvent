<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SenEvent — Prestataires pour vos événements au Sénégal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<style>
  :root{
    --ink:#16232E;
    --ivory:#FAF3E7;
    --brick:#D8482E;
    --gold:#E8A93D;
    --teal:#2E7D6B;
    --line: rgba(22,35,46,0.12);
    --card: #FFFFFF;
    box-sizing: border-box;
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top: env(safe-area-inset-top, 0px);}
  body{
    margin:0; background:var(--ivory); color:var(--ink);
    font-family:'Public Sans', system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  h1,h2,h3,.display{font-family:'Fraunces', Georgia, serif;}

  header.hero{
    background:
      radial-gradient(circle at 88% -10%, rgba(232,169,61,0.2), transparent 45%),
      radial-gradient(circle at 8% 110%, rgba(216,72,46,0.18), transparent 45%),
      var(--ink);
    color: var(--ivory);
    padding: 3.6rem 1.5rem 3rem;
    padding-top: calc(3.6rem + env(safe-area-inset-top, 0px));
    position:relative; overflow:hidden;
  }
  .hero-inner{max-width: 980px; margin: 0 auto; position:relative; z-index:1;}
  .brand{display:flex; align-items:baseline; gap:.7rem; margin-bottom: 1.6rem;}
  .brand .mark{font-family:'Fraunces', serif; font-weight:700; font-size: clamp(2.4rem, 6vw, 3.4rem); letter-spacing:-0.01em;}
  .brand .mark span{color: var(--gold);}
  .brand .tag{
    font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; opacity:.65;
    border:1px solid rgba(250,243,231,0.3); padding:.25rem .6rem; border-radius:999px;
  }
  h1{
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    line-height: 1.12; font-weight: 600; margin: 0 0 .8rem; max-width: 19ch;
  }
  .hero p.sub{font-size: 1.08rem; opacity:.85; max-width: 48ch; margin:0 0 1.8rem; line-height:1.55;}
  .tabs{display:flex; gap:.55rem; flex-wrap:wrap;}
  .tab{
    border:1px solid rgba(250,243,231,0.28); background:transparent; color:var(--ivory);
    padding:.62rem 1.15rem; border-radius:999px; font-size:.92rem; cursor:pointer;
    font-family:'Public Sans',sans-serif; font-weight:600; transition: background .15s, color .15s, border-color .15s;
  }
  .tab.active{background:var(--brick); border-color:var(--brick); color:#fff;}
  .tab:not(.active):hover{background:rgba(250,243,231,0.1);}

  main{max-width: 980px; margin: 0 auto; padding: 1.8rem 1.5rem 4.5rem;}

  .filters{
    display:flex; gap:1rem; flex-wrap:wrap; align-items:flex-end;
    margin: -2.4rem 0 2rem; padding: 1.1rem 1.2rem; background:var(--card);
    border:1px solid var(--line); border-radius: 16px;
    box-shadow: 0 12px 30px -18px rgba(22,35,46,0.35);
    position:relative; z-index:2;
  }
  .filters > div{display:flex; flex-direction:column; gap:.35rem;}
  .filters label{font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; opacity:.55;}
  .filters select, .filters input[type=text]{
    font-family:'Public Sans',sans-serif; font-size:.94rem; padding:.55rem .75rem;
    border:1px solid var(--line); border-radius:9px; background:#fff; color:var(--ink);
    min-width: 170px;
  }
  .filters select:focus, .filters input:focus{outline:2px solid var(--brick); outline-offset:1px;}

  .count{font-size:.86rem; opacity:.6; margin-bottom:1.1rem; font-weight:600;}

  .grid{display:grid; grid-template-columns: repeat(auto-fill, minmax(270px,1fr)); gap:1.3rem;}
  .card{
    background:var(--card); border:1px solid var(--line); border-radius:18px; overflow:hidden;
    display:flex; flex-direction:column; transition: transform .18s, box-shadow .18s; cursor:pointer;
  }
  .card:hover{transform: translateY(-3px); box-shadow: 0 18px 34px -20px rgba(22,35,46,0.4);}

  .modal-overlay{
    display:none; position:fixed; inset:0; background:rgba(22,35,46,0.55);
    z-index:50; align-items:center; justify-content:center; padding:1.2rem;
    padding-top: calc(1.2rem + env(safe-area-inset-top, 0px));
  }
  .modal-overlay.open{display:flex;}
  .modal-card{
    background:var(--card); border-radius:20px; max-width: 560px; width:100%;
    max-height: 88vh; overflow-y:auto; position:relative;
  }
  .modal-close{
    position:absolute; top:.7rem; right:.7rem; z-index:2; width:34px; height:34px; border-radius:50%;
    background:rgba(22,35,46,0.6); color:#fff; border:none; font-size:1.4rem; line-height:1; cursor:pointer;
  }
  .modal-close:hover{background:rgba(22,35,46,0.85);}
  .modal-photo{aspect-ratio: 16/10; border-radius:20px 20px 0 0;}
  .modal-info{padding:1.3rem 1.4rem 1.6rem; display:flex; flex-direction:column; gap:.7rem;}
  .modal-info h2{margin:0; font-size:1.4rem; font-weight:600;}
  .modal-info .meta{font-size:.86rem; opacity:.62; font-weight:500;}
  .modal-info .desc{margin:0; font-size:.95rem; line-height:1.6; opacity:.88;}
  .modal-info .tarif{font-family:'Fraunces',serif; font-weight:600; color:var(--brick); font-size:1.15rem;}
  .modal-info a.contact{
    text-align:center; text-decoration:none; background:var(--ink); color:var(--ivory);
    padding:.8rem; border-radius:10px; font-weight:600; font-size:.95rem;
  }
  .modal-info a.contact:hover{background:var(--brick);}
  .card .photo, .modal-photo{aspect-ratio: 4/3; background:#e4dccb; overflow:hidden; position:relative;}
  .modal-photo{aspect-ratio: 16/10;}
  .photo img{width:100%; height:100%; object-fit:cover; display:block;}
  .photo-strip{
    display:flex; gap:.5rem; overflow-x:auto; padding-bottom:.2rem; margin-top:.2rem;
    scroll-snap-type: x proximity;
  }
  .photo-strip img{
    width:88px; height:88px; object-fit:cover; border-radius:10px; flex:0 0 auto;
    scroll-snap-align:start; border:1px solid var(--line);
  }
  .card .badge{
    position:absolute; top:.7rem; left:.7rem; color:#fff;
    font-size:.72rem; font-weight:700; padding:.28rem .65rem; border-radius:999px;
    letter-spacing:.01em;
  }
  .badge-traiteur{background:var(--gold); color:var(--ink);}
  .badge-materiel{background:var(--brick);}
  .badge-formule{background:var(--teal);}

  .card .body{padding:1.1rem 1.2rem 1.2rem; display:flex; flex-direction:column; gap:.55rem; flex:1;}
  .card h3{margin:0; font-size:1.2rem; font-weight:600; line-height:1.25;}
  .card .meta{font-size:.82rem; opacity:.62; font-weight:500;}
  .card .desc{font-size:.89rem; line-height:1.48; opacity:.85; flex:1;}
  .card .tarif{font-family:'Fraunces',serif; font-weight:600; color:var(--brick); font-size:1.05rem;}
  .card a.contact{
    margin-top:.35rem; text-align:center; text-decoration:none; background:var(--ink); color:var(--ivory);
    padding:.68rem; border-radius:10px; font-weight:600; font-size:.9rem; transition: background .15s;
  }
  .card a.contact:hover{background:var(--brick);}

  .empty, .loading{text-align:center; padding:3.5rem 1rem; opacity:.6; font-size:.95rem;}

  footer{
    background:var(--ink); color:var(--ivory); text-align:center; padding: 2.8rem 1.5rem;
    padding-bottom: calc(2.8rem + env(safe-area-inset-bottom, 0px));
  }
  footer p{margin:0 0 1.1rem; opacity:.8; font-size:.98rem;}
  footer a.cta{
    display:inline-block; background:var(--gold); color:var(--ink); text-decoration:none;
    padding:.85rem 1.7rem; border-radius:999px; font-weight:700; font-size:.96rem; transition: transform .15s;
  }
  footer a.cta:hover{transform: translateY(-2px);}

  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){--ivory:#1B1611; --ink:#F3ECE1; --card:#241E18; --line: rgba(243,236,225,0.14);}
    :root:not([data-theme="light"]) .filters select, :root:not([data-theme="light"]) .filters input{background:#241E18; color:#F3ECE1;}
  }
  :root[data-theme="dark"]{--ivory:#1B1611; --ink:#F3ECE1; --card:#241E18; --line: rgba(243,236,225,0.14);}
</style>
</head>
<body>

<header class="hero">
  <div class="hero-inner">
    <div class="brand">
      <span class="mark">Sen<span>Event</span></span>
      <span class="tag">Sénégal</span>
    </div>
    <h1>Trouvez le bon prestataire pour votre événement</h1>
    <p class="sub">Traiteurs et loueurs de matériel événementiel, comparés au même endroit — contactez-les directement, sans intermédiaire.</p>
    <div class="tabs" id="tabs">
      <button class="tab active" data-cat="all">Tous</button>
      <button class="tab" data-cat="Traiteur">Traiteurs</button>
      <button class="tab" data-cat="Location de matériel">Location de matériel</button>
      <button class="tab" data-cat="Formule Tout-en-Un">Formule Tout-en-Un</button>
    </div>
  </div>
</header>

<main>
  <div class="filters">
    <div><label>Zone</label><select id="zoneFilter"><option value="">Toutes les zones</option></select></div>
    <div><label>Recherche</label><input type="text" id="searchInput" placeholder="Nom, spécialité..."></div>
  </div>
  <div class="count" id="count"></div>
  <div id="results" class="grid"><div class="loading">Chargement des prestataires…</div></div>
</main>

<div id="modalOverlay" class="modal-overlay">
  <div class="modal-card">
    <button id="modalClose" class="modal-close" aria-label="Fermer">×</button>
    <div id="modalBody"></div>
  </div>
</div>

<footer>
  <p>Vous êtes traiteur ou loueur de matériel événementiel ?</p>
  <a class="cta" href="https://forms.gle/em9nER4o9ssY1UuV8" target="_blank" rel="noopener">Inscrire mon activité</a>
</footer>

<script>
const CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQrSi2f5BqNtRs8V_1KFSPiIAsSnRHW3u5CrteK5l66Zwc4J5dI9UG6J3FoZG6EPfLQJSdNXN6KaXzG/pub?gid=109314719&single=true&output=csv";

let ALL = [];
let currentCat = "all";
let currentRows = [];

function norm(s){
  return s.trim().toLowerCase().replace(/[\u2018\u2019\u02BC`]/g, "'");
}
function get(row, key){
  const k = Object.keys(row).find(h => norm(h) === norm(key));
  return k ? (row[k] || "").trim() : "";
}
function allPhotos(str){
  if(!str) return [];
  return str.split(",").map(s => s.trim()).filter(Boolean);
}
function waLink(num, name){
  const digits = num.replace(/[^0-9]/g, "");
  const intl = digits.startsWith("221") ? digits : "221" + digits.replace(/^0+/, "");
  const msg = encodeURIComponent("Bonjour, j'ai trouvé votre profil sur SenEvent (" + name + ") et je suis intéressé(e) par vos services.");
  return "https://wa.me/" + intl + "?text=" + msg;
}
function badgeClass(cat){
  if(cat === "Traiteur") return "badge-traiteur";
  if(cat === "Location de matériel") return "badge-materiel";
  return "badge-formule";
}

function render(){
  const zone = document.getElementById("zoneFilter").value.toLowerCase();
  const q = document.getElementById("searchInput").value.toLowerCase().trim();

  let rows = ALL.filter(r => {
    const cat = get(r, "Catégorie de service");
    if(currentCat !== "all" && cat !== currentCat) return false;
    const rowZone = get(r, "Zone d'intervention").toLowerCase();
    if(zone && !rowZone.includes(zone)) return false;
    if(q){
      const hay = (get(r,"Nom de votre entreprise") + " " + get(r,"Spécialités traiteur") + " " + get(r,"Type de matériel proposé") + " " + get(r,"Description courte")).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  const results = document.getElementById("results");
  document.getElementById("count").textContent = rows.length + (rows.length > 1 ? " prestataires trouvés" : " prestataire trouvé");

  if(rows.length === 0){
    results.innerHTML = '<div class="empty">Aucun prestataire ne correspond pour l\'instant. Élargissez votre recherche.</div>';
    return;
  }

  results.innerHTML = rows.map((r, idx) => {
    const name = get(r,"Nom de votre entreprise") || "Prestataire";
    const cat = get(r,"Catégorie de service");
    const zoneTxt = get(r,"Zone d'intervention");
    const tarif = get(r,"Tarif");
    const photos = allPhotos(get(r,"Photos"));
    const cover = photos[0] || "";

    return `<div class="card" data-idx="${idx}">
      <div class="photo">
        ${cover ? `<img src="${cover}" alt="${name}" loading="lazy" onerror="this.style.display='none'">` : ''}
        <span class="badge ${badgeClass(cat)}">${cat}</span>
      </div>
      <div class="body">
        <h3>${name}</h3>
        <div class="meta">${zoneTxt}</div>
        ${tarif ? `<div class="tarif">${tarif}</div>` : ''}
      </div>
    </div>`;
  }).join("");

  currentRows = rows;
}

function openDetail(idx){
  const r = currentRows[idx];
  const name = get(r,"Nom de votre entreprise") || "Prestataire";
  const cat = get(r,"Catégorie de service");
  const zoneTxt = get(r,"Zone d'intervention");
  const tarif = get(r,"Tarif");
  const desc = get(r,"Description courte");
  const contact = get(r,"Numéro de contact");
  const photos = allPhotos(get(r,"Photos"));
  const spec = [get(r,"Spécialités traiteur"), get(r,"Type de matériel proposé")].filter(s => s && s.toLowerCase() !== "non applicable").join(" · ");

  const cover = photos[0] || "";
  const stripHtml = photos.length > 1 ? `
    <div class="photo-strip">
      ${photos.map(p => `<img src="${p}" alt="${name}" loading="lazy" onerror="this.style.display='none'">`).join("")}
    </div>` : "";

  document.getElementById("modalBody").innerHTML = `
    <div class="photo modal-photo">
      ${cover ? `<img src="${cover}" alt="${name}" loading="lazy" onerror="this.style.display='none'">` : ''}
      <span class="badge ${badgeClass(cat)}">${cat}</span>
    </div>
    <div class="modal-info">
      <h2>${name}</h2>
      <div class="meta">${zoneTxt}${spec ? " · " + spec : ""}</div>
      <p class="desc">${desc}</p>
      ${tarif ? `<div class="tarif">${tarif}</div>` : ''}
      ${contact ? `<a class="contact" href="${waLink(contact, name)}" target="_blank" rel="noopener">Contacter sur WhatsApp</a>` : ''}
      ${stripHtml}
    </div>`;
  document.getElementById("modalOverlay").classList.add("open");
  document.body.style.overflow = "hidden";
}
function closeDetail(){
  document.getElementById("modalOverlay").classList.remove("open");
  document.body.style.overflow = "";
}

function populateZones(){
  const zones = new Set();
  ALL.forEach(r => {
    get(r,"Zone d'intervention").split(",").forEach(z => { z = z.trim(); if(z) zones.add(z); });
  });
  const sel = document.getElementById("zoneFilter");
  [...zones].sort().forEach(z => {
    const opt = document.createElement("option");
    opt.value = z; opt.textContent = z;
    sel.appendChild(opt);
  });
}

document.getElementById("tabs").addEventListener("click", e => {
  const btn = e.target.closest(".tab");
  if(!btn) return;
  document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
  btn.classList.add("active");
  currentCat = btn.dataset.cat;
  render();
});
document.getElementById("zoneFilter").addEventListener("change", render);
document.getElementById("searchInput").addEventListener("input", render);

document.getElementById("results").addEventListener("click", e => {
  const card = e.target.closest(".card");
  if(!card) return;
  openDetail(parseInt(card.dataset.idx));
});
document.getElementById("modalClose").addEventListener("click", closeDetail);
document.getElementById("modalOverlay").addEventListener("click", e => {
  if(e.target.id === "modalOverlay") closeDetail();
});
document.addEventListener("keydown", e => { if(e.key === "Escape") closeDetail(); });

fetch(CSV_URL)
  .then(res => res.text())
  .then(csv => {
    const parsed = Papa.parse(csv, { header:true, skipEmptyLines:true });
    ALL = parsed.data.filter(r => get(r,"Nom de votre entreprise"));
    populateZones();
    render();
  })
  .catch(err => {
    document.getElementById("results").innerHTML = '<div class="empty">Impossible de charger les prestataires pour le moment. Réessayez plus tard.</div>';
    console.error(err);
  });
</script>

</body>
</html>
